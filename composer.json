{
    "name": "elgibor-solution/laravel-advanced-reports",
    "description": "A metadata-driven dynamic reporting engine for Laravel — definitions, sources, parameters, filters, grouping, aggregates, formulas, drilldowns, subreports, and HTML/PDF/Excel/CSV/JSON output.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "reports",
        "reporting",
        "crystal-reports",
        "pdf",
        "excel",
        "csv",
        "dynamic-reports",
        "saas"
    ],
    "authors": [
        {
            "name": "Elgibor Solution",
            "email": "dev@elgibor-solution.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "symfony/expression-language": "^6.0|^7.0",
        "dragonmantank/cron-expression": "^3.0|^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "barryvdh/laravel-dompdf": "^2.0|^3.0",
        "maatwebsite/excel": "^3.1"
    },
    "suggest": {
        "barryvdh/laravel-dompdf": "Required for the default PDF renderer.",
        "maatwebsite/excel": "Required for the Excel (xlsx) renderer.",
        "spatie/browsershot": "Alternative headless-Chromium PDF renderer."
    },
    "autoload": {
        "psr-4": {
            "ElgiborSolution\\AdvancedReports\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElgiborSolution\\AdvancedReports\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ElgiborSolution\\AdvancedReports\\AdvancedReportsServiceProvider"
            ],
            "aliases": {
                "AdvancedReports": "ElgiborSolution\\AdvancedReports\\Facades\\AdvancedReports"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
